{
  "manifest_version": 3,
  "name": "LeetRoulette Sync",
  "version": "1.0.0",
  "description": "Securely syncs your solved LeetCode problems directly into LeetRoulette.",
  "permissions": [
    "storage",
    "cookies"
  ],
  "host_permissions": [
    "*://leetcode.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Sync LeetCode Data"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost:5173/*",
        "https://leetroulette.com/*",
        "https://leet-roulette.vercel.app/*",
        "https://*.vercel.app/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
